{
  "outputDirectory": "hifi",
  "rewrites": [
    { "source": "/", "destination": "/AleVia Hi-Fi.html" },
    { "source": "/uploads/(.*)", "destination": "/../uploads/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
